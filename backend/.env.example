# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Database
# Default uses SQLite (zero setup) -> file stored at backend/data/evms.sqlite
DB_DIALECT=sqlite
DB_STORAGE=./data/evms.sqlite

# --- To use PostgreSQL/MySQL instead, comment SQLite above and use these ---
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=evms
# DB_USER=postgres
# DB_PASSWORD=postgres

# CORS
CLIENT_URL=http://localhost:5173

# NOTE: There is no email/SMS configuration needed. Accounts, roles, and
# passwords are entirely managed via company-roster.csv in the backend
# folder — edit that file and restart the backend to add users, change
# roles, or reset a password. See company-roster.csv for the format.
